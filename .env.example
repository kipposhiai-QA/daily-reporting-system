# Supabase (PostgreSQL) 接続情報
# Supabaseダッシュボード > Project Settings > Database > Connection string から取得する。
#
# DATABASE_URL: プーリング接続（pgbouncer, port 6543）。アプリの通常クエリで使用。
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: 直接接続（port 5432）。`npm run db:migrate` 等、マイグレーション実行時に
# `prisma migrate dev --url "$DIRECT_URL"` の形で使用する
# （Prisma ORM v7の prisma.config.ts に directUrl 相当の項目は無いため）。
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase Auth（ブラウザ用クライアント）接続情報
# Supabaseダッシュボード > Project Settings > API から取得する。
# NEXT_PUBLIC_ プレフィックスによりブラウザに公開される値のため、anon keyのみを設定する
# （service_role key等の秘匿情報は設定しないこと）。
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxxxxxxxxx"
